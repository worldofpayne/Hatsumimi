[Desktop Entry]
Type=Application
Name=Hatsumimi
GenericName=Japanese listening player
Comment=Watch Japanese media without subtitles; check the lines when you pause
Exec=@BIN@/hatsumimi %f
Icon=hatsumimi
Terminal=false
Categories=AudioVideo;Video;Player;Education;Languages;
MimeType=video/x-matroska;video/mp4;video/webm;video/x-msvideo;video/quicktime;
Keywords=japanese;subtitles;anime;learning;jimaku;
StartupWMClass=hatsumimi
